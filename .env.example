# Copier ce fichier en .env puis renseigner les identifiants SMTP du concessionnaire.
# Sans ces valeurs, les formulaires restent fonctionnels : chaque demande est archivée
# dans .data/leads côté serveur, aucun e-mail n'est envoyé.

# Serveur sortant utilisé par server/api/lead.post.ts
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=465
NUXT_SMTP_SECURE=true
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
# Expéditeur ; par défaut NUXT_SMTP_USER est utilisé
NUXT_SMTP_FROM=

# Destinataire des demandes ; par défaut NUXT_SMTP_USER est utilisé
NUXT_LEAD_TO=
