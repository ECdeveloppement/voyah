# Copier ce fichier en .env puis renseigner les identifiants SMTP du concessionnaire.
# Les demandes sont archivées dans .data/leads côté serveur.
# Les devis ne sont confirmés qu’après acceptation par le serveur SMTP.

# Domaine public utilisé pour les URL canoniques, le sitemap et les balises Open Graph.
# Sans slash final ; surchargeable via l'environnement d'hébergement.
NUXT_PUBLIC_SITE_URL=https://voyahtunisie.com

# Serveur sortant utilisé par server/api/lead.post.ts
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=465
NUXT_SMTP_SECURE=true
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
# Expéditeur ; par défaut NUXT_SMTP_USER est utilisé
# (nom alternatif accepté : NUXT_MAIL_FROM)
NUXT_SMTP_FROM=

# Destinataires de tous les formulaires, devis inclus ; séparer les adresses par des virgules.
# Priorité : NUXT_MAIL_TO, puis NUXT_LEAD_TO, puis NUXT_SMTP_USER.
NUXT_MAIL_TO=
NUXT_LEAD_TO=
